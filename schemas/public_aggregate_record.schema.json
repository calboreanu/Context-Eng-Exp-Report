{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calboreanu/Context-Eng-Exp-Report/schemas/public_aggregate_record.schema.json",
  "title": "Context Engineering public aggregate catalog record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "view", "analysis_set", "metric", "source_file", "source_record"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^AGG-[a-f0-9]{12}$"},
    "view": {"type": "string"},
    "analysis_set": {"type": "string"},
    "subgroup_type": {"type": "string"},
    "subgroup_value": {"type": "string"},
    "metric": {"type": "string"},
    "metric_label": {"type": "string"},
    "effect_scale": {"type": "string"},
    "ce_k": {"type": ["integer", "null"]},
    "ce_n": {"type": ["integer", "null"]},
    "ce_value": {"type": ["number", "null"]},
    "comparison_k": {"type": ["integer", "null"]},
    "comparison_n": {"type": ["integer", "null"]},
    "comparison_value": {"type": ["number", "null"]},
    "effect": {"type": ["number", "null"]},
    "ci_low": {"type": ["number", "null"]},
    "ci_high": {"type": ["number", "null"]},
    "rows_per_condition": {"type": ["integer", "null"]},
    "stations": {"type": ["integer", "null"]},
    "positive_stations": {"type": ["integer", "null"]},
    "tie_stations": {"type": ["integer", "null"]},
    "negative_stations": {"type": ["integer", "null"]},
    "descriptive_sign_p": {"type": ["number", "null"]},
    "window": {"type": ["integer", "null"]},
    "candidate_positive": {"type": ["integer", "null"]},
    "eligible_rows": {"type": ["integer", "null"]},
    "unresolved": {"type": ["integer", "null"]},
    "source_file": {"type": "string"},
    "source_record": {"type": "string"}
  }
}
